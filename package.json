{
  "name": "nuxters",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "eslint .",
    "collect:contributors": "node scripts/collect-contributors.ts",
    "postinstall": "nuxt prepare",
    "test:browser": "playwright test test/browser",
    "test:browser:update": "docker run --rm --network host -v $(pwd):/work/ -v /tmp/playwright-node-modules:/work/node_modules -w /work/ -it mcr.microsoft.com/playwright:v1.55.1-noble bash -c 'corepack enable && pnpm i && pnpm playwright test test/browser --update-snapshots'",
    "test:nuxt": "vitest --project nuxt",
    "test:types": "vue-tsc -b --noEmit",
    "test:unit": "vitest --project unit"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.9.9",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/devtools": "^3.4.3",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.12.0",
    "@octokit/plugin-paginate-rest": "^16.0.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@takumi-rs/core": "^2.16.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "^4.6.2",
    "nuxt-og-image": "^6.10.4",
    "octokit": "^5.0.5",
    "ofetch": "^1.5.1",
    "satori": "^0.62.0",
    "tailwindcss": "^4.3.3",
    "ufo": "^1.6.4",
    "uncrypto": "^0.1.3",
    "unstorage": "^1.17.6",
    "vue": "^3.5.44",
    "vue-confetti-explosion": "^1.0.2"
  },
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  }
}
